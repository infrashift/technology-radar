---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import QuadrantRadar from '../../../components/QuadrantRadar.vue';
import blipData from '../../../data/blips-generated.json';
import { assignBlipNumbers } from '../../../utils/blipNumbering';
import type { BlipData, Ring } from '../../../types/radar';

export async function getStaticPaths() {
  const blips = await getCollection('blips');
  return blips.map((blip) => ({
    params: { quadrant: blip.data.quadrant, slug: blip.data.id },
    props: { blip },
  }));
}

const { blip } = Astro.props;
const { Content } = await render(blip);

const ringColors: Record<string, string> = {
  adopt: '#2da44e',
  trial: '#0969da',
  assess: '#bf8700',
  hold: '#cf222e',
};

const quadrantLabels: Record<string, string> = {
  techniques: 'Techniques',
  platforms: 'Platforms',
  tools: 'Tools',
  'languages-and-frameworks': 'Languages & Frameworks',
};

const ringOrder: Ring[] = ['adopt', 'trial', 'assess', 'hold'];

// Compute numbered blips for the sidebar list
const numberedBlips = assignBlipNumbers(blipData as any);
const quadrantBlipsList = numberedBlips
  .filter((b) => b.quadrant === blip.data.quadrant)
  .sort((a, b) => {
    const ringDiff = ringOrder.indexOf(a.ring as Ring) - ringOrder.indexOf(b.ring as Ring);
    if (ringDiff !== 0) return ringDiff;
    return a.title.localeCompare(b.title);
  });

// Group by ring for display
const blipsByRing = ringOrder.map((ring) => ({
  ring,
  blips: quadrantBlipsList.filter((b) => b.ring === ring),
})).filter((g) => g.blips.length > 0);

// Resolve related blips
const allBlips = await getCollection('blips');
const relatedBlipData = (blip.data.relatedBlips || [])
  .map((id: string) => allBlips.find((b) => b.data.id === id))
  .filter(Boolean);
---

<Layout title={blip.data.title}>
  <div class="blip-page-layout">
    <article class="blip-detail">
      <nav class="breadcrumb">
        <a href="/radar">Radar</a>
        <span class="sep">/</span>
        <a href={`/radar#${blip.data.quadrant}`}>{quadrantLabels[blip.data.quadrant]}</a>
        <span class="sep">/</span>
        <span>{blip.data.title}</span>
      </nav>

      <header>
        <h1>{blip.data.title}</h1>
        <div class="meta">
          <span class="ring-badge" style={`background: ${ringColors[blip.data.ring]}`}>
            {blip.data.ring}
          </span>
          <span class="quadrant-label">{quadrantLabels[blip.data.quadrant]}</span>
          {blip.data.isNew && <span class="new-badge">NEW</span>}
        </div>
      </header>

      <div class="content">
        <Content />
      </div>

      {blip.data.history && blip.data.history.length > 0 && (
        <section class="history">
          <h2>History</h2>
          <ul>
            {blip.data.history.map((h: { date: string; ring: string }) => (
              <li>
                <span class="date">{h.date}</span>
                <span class="ring-badge small" style={`background: ${ringColors[h.ring]}`}>
                  {h.ring}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}

      {relatedBlipData.length > 0 && (
        <section class="related-blips">
          <h2>Related blips</h2>
          <ul>
            {relatedBlipData.map((related: any) => (
              <li>
                <a href={`/radar/${related.data.quadrant}/${related.data.id}`}>
                  {related.data.title}
                </a>
                <span class="related-meta">
                  <span class="ring-badge small" style={`background: ${ringColors[related.data.ring]}`}>
                    {related.data.ring}
                  </span>
                  <span class="related-quadrant">{quadrantLabels[related.data.quadrant]}</span>
                  {related.data.history?.[0]?.date && (
                    <span class="related-date">{related.data.history[0].date}</span>
                  )}
                </span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>

    <aside class="quadrant-radar-sidebar">
      <QuadrantRadar
        blips={blipData as BlipData[]}
        quadrant={blip.data.quadrant}
        highlightedBlipId={blip.data.id}
        client:load
      />
      <div class="quadrant-blip-list">
        <h3 style={`color: ${ringColors[blip.data.quadrant] || '#666'}`}>
          {quadrantLabels[blip.data.quadrant]}
        </h3>
        {blipsByRing.map((group) => (
          <div class="ring-group">
            <h4>{group.ring}</h4>
            <ul>
              {group.blips.map((b) => (
                <li class={b.id === blip.data.id ? 'current' : ''}>
                  <a href={`/radar/${b.quadrant}/${b.id}`}>
                    <span
                      class="blip-number-badge"
                      style={`background: ${ringColors[blip.data.quadrant] || '#666'}`}
                    >
                      {b.number}
                    </span>
                    {b.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </aside>
  </div>
</Layout>

<style>
  .blip-page-layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }

  @media (max-width: 1024px) {
    .blip-page-layout {
      grid-template-columns: 1fr;
    }

    .quadrant-radar-sidebar {
      display: none;
    }
  }

  .blip-detail {
    max-width: 800px;
  }

  .breadcrumb {
    margin-bottom: 2rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  .breadcrumb a {
    color: var(--color-link);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    text-decoration: underline;
  }

  .sep {
    margin: 0 0.5rem;
  }

  header {
    margin-bottom: 2rem;
  }

  h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .ring-badge {
    color: #fff;
    padding: 0.25rem 0.75rem;
    border-radius: 1rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .ring-badge.small {
    padding: 0.15rem 0.5rem;
    font-size: 0.7rem;
  }

  .quadrant-label {
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  .new-badge {
    background: var(--color-new-badge);
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .content {
    line-height: 1.8;
    font-size: 1.05rem;
  }

  .content :global(p) {
    margin-bottom: 1rem;
  }

  .history {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .history h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .history ul {
    list-style: none;
  }

  .history li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
  }

  .date {
    font-family: monospace;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
  }

  /* Related blips */
  .related-blips {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .related-blips h2 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
  }

  .related-blips ul {
    list-style: none;
  }

  .related-blips li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .related-blips li a {
    color: var(--color-link);
    text-decoration: none;
    font-weight: 500;
  }

  .related-blips li a:hover {
    text-decoration: underline;
  }

  .related-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
  }

  .related-quadrant {
    color: var(--color-text-secondary);
  }

  .related-date {
    font-family: monospace;
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
  }

  /* Quadrant radar sidebar */
  .quadrant-radar-sidebar {
    position: sticky;
    top: 1rem;
  }

  .quadrant-blip-list {
    margin-top: 1rem;
  }

  .quadrant-blip-list h3 {
    font-size: 0.9rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .quadrant-blip-list .ring-group h4 {
    font-size: 0.7rem;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0.5rem 0 0.25rem;
    font-weight: 600;
  }

  .quadrant-blip-list .ring-group ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .quadrant-blip-list .ring-group li {
    padding: 0.2rem 0.4rem;
    border-radius: 0.25rem;
    font-size: 0.8rem;
  }

  .quadrant-blip-list .ring-group li.current {
    background: var(--color-highlight-bg);
    font-weight: 600;
  }

  .quadrant-blip-list .ring-group li a {
    color: var(--color-text-primary);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .quadrant-blip-list .ring-group li a:hover {
    text-decoration: underline;
  }

  .blip-number-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    color: #fff;
    font-size: 0.6rem;
    font-weight: 700;
    flex-shrink: 0;
  }
</style>
