---
import Layout from '../../layouts/Layout.astro';
import { getRadarData } from '../../lib/blips';
import BlipSearch from '../../components/BlipSearch.vue';
import type { SearchableBlip } from '../../types/radar';

function stripMarkdown(md: string): string {
  return md
    .replace(/\*\*(.*?)\*\*/g, '$1')
    .replace(/\*(.*?)\*/g, '$1')
    .replace(/\[(.*?)\]\(.*?\)/g, '$1')
    .replace(/^import\s.*/gm, '')
    .trim();
}

const { entries } = await getRadarData();

// Only what the search UI shows or matches on, to keep the island's props small.
const searchIndex: SearchableBlip[] = entries.map(({ data, body }) => ({
  id: data.id,
  title: data.title,
  quadrant: data.quadrant,
  ring: data.ring,
  isNew: data.isNew,
  description: stripMarkdown(body || ''),
}));
---

<Layout title="Search">
  <BlipSearch blips={searchIndex} client:load />
</Layout>
