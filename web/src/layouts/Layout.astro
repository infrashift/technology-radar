---
import '../styles/theme.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Technology Radar</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/radar" class="logo">Technology Radar</a>
        <div class="nav-links">
          <a href="/radar/search" class="nav-link">Search</a>
          <a href="/radar/faq" class="nav-link">FAQ</a>
          <a href="/radar/contribute" class="nav-link">Contribute</a>
          <a href={site.repoUrl} class="nav-icon" target="_blank" rel="noopener noreferrer" aria-label="Source repository">
            <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
          </a>
          <ThemeToggle />
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  :global(*) {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :global(body) {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--color-text-primary);
    background: var(--color-bg-body);
    line-height: 1.6;
  }

  .site-header {
    background: var(--color-bg-header);
    padding: 1rem 2rem;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    color: var(--color-text-on-dark);
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .nav-link {
    color: var(--color-text-on-dark);
    text-decoration: none;
    font-size: 0.9rem;
    opacity: 0.85;
  }

  .nav-link:hover {
    opacity: 1;
  }

  .nav-icon {
    color: var(--color-text-on-dark);
    opacity: 0.85;
    display: flex;
    align-items: center;
  }

  .nav-icon:hover {
    opacity: 1;
  }

  main {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
  }
</style>
